<%# forgot-password.ejs - demande de lien de réinitialisation du mot de passe (/forgot-password). %>
<%# Reçoit : success[], error[] (messages). %>
<%# En-tête commun. %>
<%- include("partials/header") %>
<%# Page de demande de réinitialisation. %>
<main class="auth-page">
  <div class="auth-container">
    <h1>Mot de passe oublié ?</h1>
    <p>Entrez votre adresse email. Nous vous enverrons un lien pour réinitialiser votre mot de passe.</p>
    <%# Message de succès (identique que l'e-mail existe ou non, pour ne pas révéler les comptes). %>
    <% if (success && success.length) { %>
      <div class="alert alert-success"><%= success[0] %></div>
    <% } %>
    <%# Message d'erreur éventuel. %>
    <% if (error && error.length) { %>
      <div class="alert alert-error"><%= error[0] %></div>
    <% } %>
    <%# Formulaire : envoie l'adresse e-mail vers /forgot-password ; un lien valable 30 minutes est envoyé par e-mail. %>
    <form action="/forgot-password" method="POST">
      <label for="email">Adresse email</label>
      <input type="email" id="email" name="email" placeholder="exemple@email.com" autocomplete="email" required >
      <button type="submit"> Envoyer le lien </button>
    </form>
    <%# Retour à la page de connexion. %>
    <a href="/login">Retour à la connexion</a>
  </div>
</main>
<%# Pied de page commun. %>
<%- include("partials/footer") %>
