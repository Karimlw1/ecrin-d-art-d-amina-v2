
<%# Page d'accueil de la boutique %>
<%- include("partials/header", { title }) %>

<% const productList = products || []; %>

<%# HERO SECTION %>
<section class="hero-grid">

    <%# Carrousel de produits %>
    <section class="hero-carousel">

        <% if (productList.length > 0) { %>

            <% productList.forEach(function(product, index) { %>

                <div
                    class="hero-slide <%= index === 0 ? 'active' : '' %>"
                    style="background-image: url('<%= product.image_url %>');"
                >
                    <div class="hero-copy">
                        <span class="eyebrow">
                            LA MEILLEURE BOUTIQUE EN LIGNE DE KINSHASA
                        </span>

                        <p>
                            Découvrez votre prochaine pièce préférée dans notre collection.
                        </p>
                    </div>
                </div>

            <% }); %>

            <% if (productList.length > 1) { %>

                <button
                    class="carousel-arrow prev"
                    type="button"
                    aria-label="Produit précédent"
                >
                    &#10094;
                </button>

                <button
                    class="carousel-arrow next"
                    type="button"
                    aria-label="Produit suivant"
                >
                    &#10095;
                </button>

                <div class="carousel-dots">

                    <% productList.forEach(function(product, index) { %>

                        <button
                            class="carousel-dot <%= index === 0 ? 'active' : '' %>"
                            type="button"
                            aria-label="Afficher le produit <%= index + 1 %>"
                        ></button>

                    <% }); %>

                </div>

            <% } %>

        <% } else { %>

            <div class="hero-copy">
                <span class="eyebrow">BIENVENUE CHEZ ECRIN</span>

                <h1>
                    Trouvez votre<br>
                    <em>style au quotidien.</em>
                </h1>

                <p>Découvrez une mode choisie avec soin.</p>

                <a class="btn btn-dark" href="/shop">
                    Découvrir la collection →
                </a>
            </div>

        <% } %>

    </section>

    <%# Bannière de livraison %>
    <div class="livraisonIMG" id="livraison"></div>

    <%# Catégories %>
    <div class="hero-side">

        <% const tiles = [
            { name: "Femme", slug: "femme", tone: "peach", symbol: "F" },
            { name: "Homme", slug: "homme", tone: "mint", symbol: "H" },
            { name: "Enfant", slug: "enfant", tone: "lilac", symbol: "E" },
            { name: "Accessoires", slug: "accessoires", tone: "blue", symbol: "+" }
        ]; %>

        <% tiles.forEach(tile => { %>

            <a
                class="category-tile <%= tile.tone %>"
                href="/shop?category=<%= tile.slug %>"
            >
                <span class="tile-symbol"><%= tile.symbol %></span>

                <div>
                    <h3><%= tile.name %></h3>
                    <span>Découvrir</span>
                </div>
            </a>

        <% }); %>

    </div>

</section>

<%# SECTION DE CONNEXION %>
<% if (!user) { %>

    <section class="auth-section" id="auth-section">

        <div class="section-heading">
            <div>
                <img src="/uploads/whiteBG.jpeg" alt="Logo Ecrin">
            </div>
        </div>

        <div class="empty-state">

            <h3>Connectez-vous.</h3>

            <a class="btn btn-dark" href="/login">
                Se connecter ↗
            </a>

            <h3>Nouveau client ?</h3>

            <a class="btn btn-light" href="/register">
                Créer un compte ↗
            </a>

        </div>

        <h2 id="hideAuthSection">
            Continuer sans Compte !!!
            <span class="accent-dot">.</span>
        </h2>

    </section>

<% } %>

<%# SECTION NOUVEAUTES %>
<section class="section product-section">

    <div class="section-heading">

        <div>
            <span class="eyebrow">SÉLECTIONNÉ POUR VOUS</span>
            <h2>
                Nouveautés<span class="accent-dot">.</span>
            </h2>
        </div>

        <a class="underlined-link" href="/shop">
            Voir tous les produits
        </a>

    </div>

    <% if (productList.length > 0) { %>

        <div class="product-grid">

            <% productList.forEach(product => { %>

                <%- include("partials/product-card", {
                    product,
                    currency: currency || "CDF"
                }) %>

            <% }); %>

        </div>

    <% } else { %>

        <div class="empty-state">

            <div class="empty-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2.5 14.4 9.6 21.5 12l-7.1 2.4L12 21.5l-2.4 7.1L2.5 12l7.1-2.4L12 2.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="m19 2 .7 2.3L22 5l-2.3.7L19 8l-.7-2.3L16 5l2.3-.7L19 2Z" fill="currentColor"/>
                </svg>
            </div>

            <h3>
                Votre prochain coup de cœur commence ici.
            </h3>

            <p>
                Les produits apparaîtront lorsque l'administrateur
                les ajoutera depuis le tableau de bord.
            </p>

        </div>

    <% } %>

</section>

<%# BANNIERE PROMOTIONNELLE %>
<section class="editorial-banner">

    <div>
        <span class="eyebrow">
            LA SÉLECTION ECRIN D'ART D'AMINA
        </span>

        <h2>
            Portez ce qui<br>
            vous inspire.
        </h2>

        <p>
            Couleur, texture, assurance. Faites-en votre style.
        </p>

        <a class="btn btn-light" href="/shop">
            Découvrir la sélection
        </a>
    </div>

    <div class="editorial-orbit">
        <span>LE STYLE EST PERSONNEL</span>
    </div>

</section>

<%# PIED DE PAGE %>
<%- include("partials/footer") %>
