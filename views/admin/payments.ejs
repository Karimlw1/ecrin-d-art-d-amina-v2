
<%# admin/payments.ejs - Suivi et vérification des paiements. %>
<%# Reçoit : title, payments[]. Chaque paiement peut contenir proof_url. %>

<%- include("partials-top", { title, active: "payments" }) %>


<%# AVERTISSEMENT DE SÉCURITÉ %>
<div class="notice-box">
  <strong>Sécurité des paiements</strong>

  <p>
    Vérifiez chaque transaction auprès du prestataire officiel
    avant de marquer une commande comme payée.
    Une capture d'écran ne constitue pas une confirmation de paiement.
  </p>
</div>


<%# CONTENU PRINCIPAL %>
<div class="admin-panel">

  <div class="panel-heading">

    <div>
      <span class="eyebrow">MOUVEMENTS D'ARGENT</span>
      <h2>Suivi des paiements</h2>

      <p class="muted small">
        Consultez les preuves et gérez les confirmations de paiement.
      </p>
    </div>

    <span class="muted small">
      <%= payments.length %> paiement(s)
    </span>

  </div>


  <%# TABLEAU DES PAIEMENTS %>
  <div class="table-wrap">

    <table>

      <thead>
        <tr>
          <th>Commande / client</th>
          <th>Paiement</th>
          <th>Coordonnées du payeur</th>
          <th>Preuve</th>
          <th>Statut</th>
          <th>Gestion</th>
        </tr>
      </thead>


      <tbody>

        <% if (!payments.length) { %>

          <tr>
            <td colspan="6" class="muted">
              Aucun paiement enregistré pour le moment.
            </td>
          </tr>

        <% } %>


        <% payments.forEach(p => { %>

          <tr>

            <%# COMMANDE ET CLIENT %>
            <td>

              <strong>
                <%= p.order_number %>
              </strong>

              <br>

              <span>
                <%= p.customer_name %>
              </span>

              <br>

              <small class="muted">
                <%= new Date(p.created_at).toLocaleString("fr-FR") %>
              </small>

            </td>


            <%# MOYEN ET MONTANT %>
            <td>

              <strong>
                <%= label(p.provider) %>
              </strong>

              <br>

              <span>
                <%= Number(p.amount).toFixed(2) %>
                <%= p.currency %>
              </span>

            </td>


            <%# INFORMATIONS DU PAYEUR %>
            <td>

              <strong>
                <%= p.payer_phone || "Non renseigné" %>
              </strong>

              <% if (p.customer_phone) { %>

                <br>

                <small class="muted">
                  Client : <%= p.customer_phone %>
                </small>

              <% } %>

              <% if (p.provider_reference) { %>

                <br>

                <small class="muted">
                  Réf. : <%= p.provider_reference %>
                </small>

              <% } %>

            </td>


            <%# PREUVE DE PAIEMENT %>
            <td>

              <% if (p.proof_url) { %>

                <a
                  href="<%= p.proof_url %>"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-dark btn-small"
                >
                  <span>↗</span> Voir la capture
                </a>

              <% } else { %>

                <span class="muted">
                  Aucune capture
                </span>

              <% } %>

            </td>


            <%# STATUT DU PAIEMENT %>
            <td>

              <span class="status-pill status-<%= p.status %>">
                <%= label(p.status) %>
              </span>

            </td>


            <%# ACTIONS ADMINISTRATEUR %>
            <td>

              <form
                action="/admin/payments/<%= p.id %>/status"
                method="POST"
                class="payment-admin-form"
              >

                <label
                  for="payment-status-<%= p.id %>"
                  class="muted small"
                >
                  Statut du paiement
                </label>

                <select
                  name="status"
                  id="payment-status-<%= p.id %>"
                  required
                >

                  <% [
                    "pending",
                    "awaiting_confirmation",
                    "paid",
                    "failed",
                    "refunded"
                  ].forEach(s => { %>

                    <option
                      value="<%= s %>"
                      <%= p.status === s ? "selected" : "" %>
                    >
                      <%= label(s) %>
                    </option>

                  <% }) %>

                </select>


                <label
                  for="payment-reference-<%= p.id %>"
                  class="muted small"
                >
                  Référence de transaction
                </label>

                <input
                  type="text"
                  id="payment-reference-<%= p.id %>"
                  name="provider_reference"
                  value="<%= p.provider_reference || '' %>"
                  placeholder="Référence de transaction"
                  maxlength="190"
                >


                <label
                  for="payment-note-<%= p.id %>"
                  class="muted small"
                >
                  Note administrative
                </label>

                <input
                  type="text"
                  id="payment-note-<%= p.id %>"
                  name="admin_note"
                  value="<%= p.admin_note || '' %>"
                  placeholder="Ex. : Transaction vérifiée"
                  maxlength="500"
                >


                <button
                  type="submit"
                  class="btn btn-dark btn-small"
                >
                  Enregistrer
                </button>

              </form>

            </td>

          </tr>

        <% }) %>

      </tbody>

    </table>

  </div>

</div>


<%- include("partials-bottom") %>
