
<%# checkout.ejs - Page de commande et de paiement. %>
<%# Reçoit : title, items[], subtotal, user. %>

<%- include("partials/header", { title }) %>

<section class="page-hero compact-hero">
  <img src="/uploads/EAblack.png" alt="">

  <span class="eyebrow">PRESQUE À VOUS</span>

  <h1>Finalisez votre <em>commande.</em></h1>

  <p>Quelques informations et votre commande sera bientôt prête.</p>
</section>


<section class="section checkout-layout">

  <%# FORMULAIRE DE COMMANDE %>

  <form
    action="/checkout"
    method="post"
    enctype="multipart/form-data"
    class="checkout-form"
  >

    <%# ÉTAPE 1 : CONTACT ET LIVRAISON %>

    <div class="form-panel">

      <h2>01 <span>Contact et livraison</span></h2>

      <p class="muted small">
        Où pouvons-nous vous livrer ?
      </p>

      <div class="form-grid">

        <div class="field full-field">
          <label>Nom complet *</label>

          <input
            type="text"
            name="customer_name"
            value="<%= user ? user.full_name : '' %>"
            placeholder="Votre nom complet"
            required
          >
        </div>


        <div class="field">
          <label>Adresse e-mail</label>

          <input
            type="email"
            name="customer_email"
            value="<%= user ? user.email : '' %>"
            placeholder="exemple@email.com"
          >
        </div>


        <div class="field">
          <label>Téléphone *</label>

          <input
            type="tel"
            name="customer_phone"
            placeholder="+243..."
            required
          >
        </div>


        <div class="field">
          <label>Pays *</label>

          <select name="shipping_country" required>
            <option value="RD Congo">RD Congo</option>
            <option value="Ouganda">Ouganda</option>
            <option value="Rwanda">Rwanda</option>
            <option value="Autre">Autre</option>
          </select>
        </div>


        <div class="field">
          <label>Ville *</label>

          <input
            type="text"
            name="shipping_city"
            placeholder="Goma, Kinshasa..."
            required
          >
        </div>


        <div class="field full-field">
          <label>Adresse de livraison *</label>

          <input
            type="text"
            name="shipping_address"
            placeholder="Quartier, avenue, numéro de maison..."
            required
          >
        </div>


        <div class="field full-field">
          <label>Note supplémentaire</label>

          <textarea
            name="customer_note"
            rows="3"
            placeholder="Un point de repère ou une précision pour la livraison..."
          ></textarea>
        </div>

      </div>

    </div>


    <%# ÉTAPE 2 : MODE DE PAIEMENT %>

    <div class="form-panel">

      <h2>02 <span>Mode de paiement</span></h2>

      <p class="muted small">
        Choisissez comment vous souhaitez payer.
      </p>


      <div class="payment-options">

        <%# AIRTEL MONEY %>

        <label class="payment-option">

          <input
            type="radio"
            name="payment_method"
            value="airtel_money"
            required
          >

          <span class="payment-icon">A</span>

          <span>
            <strong>Airtel Money</strong>
            <small>Paiement mobile</small>
          </span>

        </label>


        <%# ORANGE MONEY %>

        <label class="payment-option">

          <input
            type="radio"
            name="payment_method"
            value="orange_money"
            required
          >

          <span class="payment-icon">O</span>

          <span>
            <strong>Orange Money</strong>
            <small>Paiement mobile</small>
          </span>

        </label>


        <%# CASH ON DELIVERY %>

        <label class="payment-option">

          <input
            type="radio"
            name="payment_method"
            value="cash_on_delivery"
            required
          >

          <span class="payment-icon">₣</span>

          <span>
            <strong>Paiement à la livraison</strong>
            <small>Payez lorsque vous recevez votre commande.</small>
          </span>

        </label>

      </div>


      <%# INSTRUCTIONS POUR MOBILE MONEY %>

      <div id="mobile-payment-details" class="hidden">

        <div class="payment-instructions">

          <h3>Comment effectuer votre paiement ?</h3>

          <p>
            Suivez ces étapes pour envoyer votre argent.
          </p>


          <%# NUMÉRO DU BÉNÉFICIAIRE %>

          <div class="recipient-box">

            <span class="muted small">
              Envoyez votre paiement à ce numéro :
            </span>

            <div class="recipient-number">
              <strong id="recipient-number"></strong>

              <button
                type="button"
                id="copy-recipient"
                class="btn btn-small"
              >
                Copier
              </button>
            </div>

            <small id="recipient-provider"></small>

          </div>


          <ol class="payment-steps">
            <li>Ouvrez votre application Mobile Money.</li>
            <li>Envoyez le montant exact de votre commande au numéro indiqué.</li>
            <li>Conservez le message de confirmation de la transaction.</li>
            <li>Revenez ici pour compléter les informations ci-dessous.</li>
          </ol>

        </div>


        <%# INFORMATIONS DU PAIEMENT %>

        <div class="form-grid payment-proof-fields">

          <div class="field full-field">

            <label>Votre numéro Mobile Money *</label>

            <input
              type="tel"
              name="payer_phone"
              id="payer-phone"
              placeholder="+2439XXXXXXXX"
              pattern="\+243[0-9]{9}"
            >

            <small>
              Le numéro depuis lequel vous avez envoyé l'argent.
            </small>

          </div>


          <div class="field full-field">

            <label>Référence de la transaction *</label>

            <input
              type="text"
              name="provider_reference"
              id="provider-reference"
              placeholder="Ex. : 123456789ABC"
            >

            <small>
              Vous trouverez cette référence dans votre SMS
              ou votre reçu Mobile Money.
            </small>

          </div>


          <div class="field full-field">

            <label>Capture d'écran du paiement *</label>

            <input
              type="file"
              name="payment_proof"
              id="payment-proof"
              accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif"
            >

            <small>
              Formats acceptés : JPG, PNG, WEBP ou GIF.
              Taille maximale : 5 Mo.
            </small>

          </div>

        </div>

      </div>


      <%# MESSAGE POUR LE PAIEMENT À LA LIVRAISON %>

      <div id="cash-payment-message" class="notice-box hidden">

        <strong>Vous avez choisi le paiement à la livraison.</strong>

        <p>
          Aucun transfert Mobile Money n'est nécessaire.
          Vous réglerez votre commande à sa réception.
        </p>

      </div>

    </div>


    <%# CONFIRMATION DE LA COMMANDE %>

    <div class="form-panel checkout-confirmation">

      <h2>03 <span>Confirmation</span></h2>

      <p class="muted small">
        Vérifiez vos informations avant de terminer.
      </p>

      <button
        type="submit"
        class="btn btn-dark btn-full checkout-submit"
      >
        Confirmer ma commande <span>↗</span>
      </button>

      <p class="muted small">
        Pour Mobile Money, votre commande sera enregistrée
        en attente de vérification. Notre équipe vérifiera
        la transaction avant de confirmer le paiement.
      </p>

    </div>

  </form>


  <%# RÉCAPITULATIF DE LA COMMANDE %>

  <aside class="summary-card checkout-summary">

    <h3>Votre commande</h3>

    <p class="muted small">
      Vérifiez les articles avant de commander.
    </p>


    <% items.forEach(item => { %>

      <div class="checkout-item">

        <div class="checkout-thumb">

          <% if (item.image_url) { %>

            <img src="<%= item.image_url %>" alt="">

          <% } else { %>

            A.

          <% } %>

        </div>


        <div>
          <strong><%= item.name %></strong>

          <small>
            <%= item.size %> · <%= item.color_name %>
            × <%= item.quantity %>
          </small>
        </div>


        <strong>
          $<%= (item.price * item.quantity).toFixed(2) %>
        </strong>

      </div>

    <% }) %>


    <div class="summary-line">

      <span>Sous-total</span>

      <strong>
        $<%= subtotal.toFixed(2) %>
      </strong>

    </div>


    <div class="summary-line">

      <span>Livraison</span>

      <span>À confirmer</span>

    </div>


    <div class="summary-line summary-total">

      <span>Total à payer</span>

      <strong>
        $<%= subtotal.toFixed(2) %>
      </strong>

    </div>


    <div class="notice-box">
      <strong>Petit rappel</strong>

      <p>
        Pour Mobile Money, envoyez exactement le montant affiché
        et joignez votre preuve de paiement.
      </p>
    </div>

  </aside>

</section>


<%# JAVASCRIPT : AFFICHAGE DES CHAMPS SELON LE PAIEMENT %>

<script>

  // Récupérer les éléments HTML.

  const paymentMethods = document.querySelectorAll(
    'input[name="payment_method"]'
  );

  const mobileDetails = document.getElementById(
    "mobile-payment-details"
  );

  const cashMessage = document.getElementById(
    "cash-payment-message"
  );

  const recipientNumber = document.getElementById(
    "recipient-number"
  );

  const recipientProvider = document.getElementById(
    "recipient-provider"
  );

  const payerPhone = document.getElementById(
    "payer-phone"
  );

  const providerReference = document.getElementById(
    "provider-reference"
  );

  const paymentProof = document.getElementById(
    "payment-proof"
  );


  // Mettre à jour les instructions selon le moyen de paiement.

  function updatePaymentFields() {

    const selected = document.querySelector(
      'input[name="payment_method"]:checked'
    );

    const method = selected ? selected.value : "";


    const isMobileMoney =
      method === "airtel_money" ||
      method === "orange_money";


    // Afficher ou masquer les informations Mobile Money.

    mobileDetails.classList.toggle(
      "hidden",
      !isMobileMoney
    );


    // Afficher ou masquer le message de paiement à la livraison.

    cashMessage.classList.toggle(
      "hidden",
      method !== "cash_on_delivery"
    );


    // Rendre les champs obligatoires uniquement pour Mobile Money.

    payerPhone.required = isMobileMoney;
    providerReference.required = isMobileMoney;
    paymentProof.required = isMobileMoney;


    // Afficher le bon numéro du bénéficiaire.

  if (
  payment_method === "airtel_money" ||
  payment_method === "orange_money"
) {
  const cleanPhone = String(payer_phone || "").replace(/\s/g, "");

  if (!/^\+243\d{9}$/.test(cleanPhone)) {
    req.flash("error", "Veuillez saisir un numéro valide au format +2439XXXXXXXX.");
    return res.redirect("/checkout");
  }

  if (!provider_reference || !req.file) {
    req.flash("error", "Veuillez fournir la référence et la capture du paiement.");
    return res.redirect("/checkout");
  }
}


  // Écouter le changement du mode de paiement.

  paymentMethods.forEach(method => {

    method.addEventListener(
      "change",
      updatePaymentFields
    );

  });


  // Copier le numéro du bénéficiaire.

  document.getElementById("copy-recipient").addEventListener(
    "click",
    async function() {

      try {

        await navigator.clipboard.writeText(
          recipientNumber.textContent
        );

        this.textContent = "Copié !";

      } catch (error) {

        alert("Impossible de copier le numéro.");

      }

    }
  );


  // Initialiser les champs.

  updatePaymentFields();

</script>


<%- include("partials/footer") %>
