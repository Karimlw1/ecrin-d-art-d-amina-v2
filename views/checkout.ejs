
<%# checkout.ejs - Page de commande et de paiement. %>
<%# Reçoit : title, items[], subtotal, user. %>

<%- include("partials/header", { title }) %>

<%# HERO %>
<section class="page-hero compact-hero">
  <img src="/uploads/EAblack.png" alt="">

  <span class="eyebrow">PRESQUE À VOUS</span>

  <h1>Finalisez votre <em>commande.</em></h1>

  <p>Quelques informations et votre commande sera bientôt prête.</p>
</section>


<section class="section checkout-layout">

  <%# FORMULAIRE DE COMMANDE %>
  <form
    action="/checkout"
    method="POST"
    enctype="multipart/form-data"
    class="checkout-form"
    id="checkout-form"
  >

    <%# ÉTAPE 1 : CONTACT ET LIVRAISON %>
    <div class="form-panel">

      <h2>01 <span>Contact et livraison</span></h2>

      <p class="muted small">
        Où pouvons-nous vous livrer ?
      </p>

      <div class="form-grid">

        <div class="field full-field">
          <label for="customer-name">Nom complet *</label>

          <input
            type="text"
            id="customer-name"
            name="customer_name"
            value="<%= user ? user.full_name : '' %>"
            placeholder="Votre nom complet"
            autocomplete="name"
            required
          >
        </div>


        <div class="field">
          <label for="customer-email">Adresse e-mail</label>

          <input
            type="email"
            id="customer-email"
            name="customer_email"
            value="<%= user ? user.email : '' %>"
            placeholder="exemple@email.com"
            autocomplete="email"
          >
        </div>


        <div class="field">
          <label for="customer-phone">Téléphone *</label>

          <input
            type="tel"
            id="customer-phone"
            name="customer_phone"
            placeholder="+243..."
            autocomplete="tel"
            required
          >
        </div>


        <div class="field">
          <label for="shipping-country">Pays *</label>

          <select
            name="shipping_country"
            id="shipping-country"
            required
          >
            <option value="RD Congo">RD Congo</option>
            <option value="Ouganda">Ouganda</option>
            <option value="Rwanda">Rwanda</option>
            <option value="Autre">Autre</option>
          </select>
        </div>


        <div class="field">
          <label for="shipping-city">Ville *</label>

          <input
            type="text"
            id="shipping-city"
            name="shipping_city"
            placeholder="Goma, Kinshasa..."
            autocomplete="address-level2"
            required
          >
        </div>


        <div class="field full-field">
          <label for="shipping-address">Adresse de livraison *</label>

          <input
            type="text"
            id="shipping-address"
            name="shipping_address"
            placeholder="Quartier, avenue, numéro de maison..."
            autocomplete="street-address"
            required
          >
        </div>


        <div class="field full-field">
          <label for="customer-note">Note supplémentaire</label>

          <textarea
            id="customer-note"
            name="customer_note"
            rows="3"
            placeholder="Un point de repère ou une précision pour la livraison..."
          ></textarea>
        </div>

      </div>
    </div>


    <%# ÉTAPE 2 : MODE DE PAIEMENT %>
    <div class="form-panel">

      <h2>02 <span>Mode de paiement</span></h2>

      <p class="muted small">
        Choisissez comment vous souhaitez payer.
      </p>


      <div class="payment-options">

        <%# AIRTEL MONEY %>
        <label class="payment-option">

          <input
            type="radio"
            name="payment_method"
            value="airtel_money"
            required
          >

          <span class="payment-icon">A</span>

          <span>
            <strong>Airtel Money</strong>
            <small>Paiement mobile</small>
          </span>

        </label>


        <%# ORANGE MONEY %>
        <label class="payment-option">

          <input
            type="radio"
            name="payment_method"
            value="orange_money"
            required
          >

          <span class="payment-icon">O</span>

          <span>
            <strong>Orange Money</strong>
            <small>Paiement mobile</small>
          </span>

        </label>


        <%# PAIEMENT À LA LIVRAISON %>
        <label class="payment-option">

          <input
            type="radio"
            name="payment_method"
            value="cash_on_delivery"
            required
          >

          <span class="payment-icon">₣</span>

          <span>
            <strong>Paiement à la livraison</strong>
            <small>Payez lorsque vous recevez votre commande.</small>
          </span>

        </label>

      </div>


      <%# INSTRUCTIONS MOBILE MONEY %>
      <div id="mobile-payment-details" class="hidden">

        <div class="payment-instructions">

          <h3>Comment effectuer votre paiement ?</h3>

          <p>
            Suivez ces étapes pour envoyer votre argent.
          </p>


          <%# NUMÉRO DU BÉNÉFICIAIRE %>
          <div class="recipient-box">

            <span class="muted small">
              Envoyez votre paiement à ce numéro :
            </span>

            <div class="recipient-number">

              <strong id="recipient-number" aria-live="polite"></strong>

              <button
                type="button"
                id="copy-recipient"
                class="btn btn-small"
              >
                Copier
              </button>

            </div>

            <small id="recipient-provider"></small>

          </div>


          <ol class="payment-steps">
            <li>Ouvrez votre application Mobile Money.</li>
            <li>Envoyez le montant exact de votre commande au numéro indiqué.</li>
            <li>Conservez le message de confirmation de la transaction.</li>
            <li>Revenez ici pour compléter les informations ci-dessous.</li>
          </ol>

        </div>


        <%# PREUVE DE PAIEMENT %>
        <div class="form-grid payment-proof-fields">

          <div class="field full-field">

            <label for="payer-phone">
              Votre numéro Mobile Money *
            </label>

            <input
              type="tel"
              name="payer_phone"
              id="payer-phone"
              placeholder="+2439XXXXXXXX"
              pattern="\+243[0-9]{9}"
              maxlength="13"
              autocomplete="tel"
            >

            <small>
              Le numéro depuis lequel vous avez envoyé l'argent.
              Format : +243 suivi de 9 chiffres.
            </small>

          </div>


          <div class="field full-field">

            <label for="provider-reference">
              Référence de la transaction *
            </label>

            <input
              type="text"
              name="provider_reference"
              id="provider-reference"
              placeholder="Ex. : 123456789ABC"
              maxlength="190"
            >

            <small>
              Vous trouverez cette référence dans votre SMS
              ou votre reçu Mobile Money.
            </small>

          </div>


          <div class="field full-field">

            <label for="payment-proof">
              Capture d'écran du paiement *
            </label>

            <input
              type="file"
              name="payment_proof"
              id="payment-proof"
              accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif"
            >

            <small>
              Formats acceptés : JPG, PNG, WEBP ou GIF.
              Taille maximale : 5 Mo.
            </small>

          </div>

        </div>

      </div>


      <%# PAIEMENT À LA LIVRAISON %>
      <div id="cash-payment-message" class="notice-box hidden">

        <strong>Vous avez choisi le paiement à la livraison.</strong>

        <p>
          Aucun transfert Mobile Money n'est nécessaire.
          Vous réglerez votre commande à sa réception.
        </p>

      </div>

    </div>


    <%# ÉTAPE 3 : CONFIRMATION %>
    <div class="form-panel checkout-confirmation">

      <h2>03 <span>Confirmation</span></h2>

      <p class="muted small">
        Vérifiez vos informations avant de terminer.
      </p>

      <button
        type="submit"
        class="btn btn-dark btn-full checkout-submit"
        id="checkout-submit"
      >
        Confirmer ma commande <span>↗</span>
      </button>

      <p class="muted small">
        Pour Mobile Money, votre commande sera enregistrée
        en attente de vérification. Notre équipe vérifiera
        la transaction avant de confirmer le paiement.
      </p>

    </div>

  </form>


  <%# RÉCAPITULATIF DE LA COMMANDE %>
  <aside class="summary-card checkout-summary">

    <h3>Votre commande</h3>

    <p class="muted small">
      Vérifiez les articles avant de commander.
    </p>


    <% items.forEach(item => { %>

      <div class="checkout-item">

        <div class="checkout-thumb">

          <% if (item.image_url) { %>

            <img
              src="<%= item.image_url %>"
              alt="<%= item.name %>"
              loading="lazy"
            >

          <% } else { %>

            A.

          <% } %>

        </div>


        <div>
          <strong><%= item.name %></strong>

          <small>
            <%= item.size %> · <%= item.color_name %>
            × <%= item.quantity %>
          </small>
        </div>


        <strong>
          $<%= (Number(item.price) * Number(item.quantity)).toFixed(2) %>
        </strong>

      </div>

    <% }) %>


    <div class="summary-line">

      <span>Sous-total</span>

      <strong>
        $<%= Number(subtotal).toFixed(2) %>
      </strong>

    </div>


    <div class="summary-line">

      <span>Livraison</span>

      <span>À confirmer</span>

    </div>


    <div class="summary-line summary-total">

      <span>Total à payer</span>

      <strong>
        $<%= Number(subtotal).toFixed(2) %>
      </strong>

    </div>


    <div class="notice-box">

      <strong>Petit rappel</strong>

      <p>
        Pour Mobile Money, envoyez exactement le montant affiché
        et joignez votre preuve de paiement.
      </p>

    </div>

  </aside>

</section>


<%# JAVASCRIPT : GESTION DU PAIEMENT %>
<script>
  // Récupérer les éléments de la page.
  const paymentMethods = document.querySelectorAll(
    'input[name="payment_method"]'
  );

  const mobileDetails = document.getElementById(
    "mobile-payment-details"
  );

  const cashMessage = document.getElementById(
    "cash-payment-message"
  );

  const recipientNumber = document.getElementById(
    "recipient-number"
  );

  const recipientProvider = document.getElementById(
    "recipient-provider"
  );

  const payerPhone = document.getElementById(
    "payer-phone"
  );

  const providerReference = document.getElementById(
    "provider-reference"
  );

  const paymentProof = document.getElementById(
    "payment-proof"
  );

  const copyButton = document.getElementById(
    "copy-recipient"
  );


  // Numéros de réception des paiements.
  const paymentRecipients = {
    airtel_money: {
      number: "0976203805",
      provider: "Airtel Money"
    },

    orange_money: {
      number: "0853958848",
      provider: "Orange Money"
    }
  };


  // Mettre à jour les informations selon le paiement choisi.
  function updatePaymentFields() {

    const selected = document.querySelector(
      'input[name="payment_method"]:checked'
    );

    const method = selected ? selected.value : "";

    const isMobileMoney =
      method === "airtel_money" ||
      method === "orange_money";


    // Afficher les instructions Mobile Money.
    mobileDetails.classList.toggle(
      "hidden",
      !isMobileMoney
    );


    // Afficher le message de paiement à la livraison.
    cashMessage.classList.toggle(
      "hidden",
      method !== "cash_on_delivery"
    );


    // Champs obligatoires uniquement pour Mobile Money.
    payerPhone.required = isMobileMoney;
    providerReference.required = isMobileMoney;
    paymentProof.required = isMobileMoney;


    // Afficher le bon numéro de réception.
    if (isMobileMoney) {

      const recipient = paymentRecipients[method];

      recipientNumber.textContent = recipient.number;
      recipientProvider.textContent = recipient.provider;

    } else {

      recipientNumber.textContent = "";
      recipientProvider.textContent = "";

    }

  }


  // Écouter les changements du mode de paiement.
  paymentMethods.forEach(method => {

    method.addEventListener(
      "change",
      updatePaymentFields
    );

  });


  // Copier le numéro du bénéficiaire.
  copyButton.addEventListener("click", async function() {

    const number = recipientNumber.textContent.trim();

    if (!number) {
      return;
    }

    try {

      await navigator.clipboard.writeText(number);

      this.textContent = "Copié !";

      setTimeout(() => {
        this.textContent = "Copier";
      }, 2000);

    } catch (error) {

      alert("Impossible de copier le numéro.");

    }

  });


  // Vérifier les informations avant l'envoi.
  document.getElementById("checkout-form").addEventListener(
    "submit",
    function(event) {

      const selected = document.querySelector(
        'input[name="payment_method"]:checked'
      );

      if (!selected) {
        return;
      }

      const method = selected.value;

      const isMobileMoney =
        method === "airtel_money" ||
        method === "orange_money";

      if (!isMobileMoney) {
        return;
      }

      // Vérifier le numéro Mobile Money.
      const cleanPhone = payerPhone.value.replace(/\s/g, "");

      if (!/^\+243[0-9]{9}$/.test(cleanPhone)) {

        event.preventDefault();

        payerPhone.setCustomValidity(
          "Saisissez un numéro valide au format +243 suivi de 9 chiffres."
        );

        payerPhone.reportValidity();

        return;

      }

      payerPhone.setCustomValidity("");


      // Vérifier la référence de transaction.
      if (!providerReference.value.trim()) {

        event.preventDefault();

        providerReference.reportValidity();

        return;

      }


      // Vérifier la capture d'écran.
      if (!paymentProof.files.length) {

        event.preventDefault();

        paymentProof.reportValidity();

        return;

      }


      // Vérifier la taille du fichier.
      const file = paymentProof.files[0];

      if (file.size > 5 * 1024 * 1024) {

        event.preventDefault();

        alert("La capture d'écran ne doit pas dépasser 5 Mo.");

        paymentProof.value = "";

        return;

      }

    }
  );


  // Initialiser la page.
  updatePaymentFields();
</script>


<%- include("partials/footer") %>
