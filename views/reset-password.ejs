<%# reset-password.ejs - choix d'un nouveau mot de passe (/reset-password/:token). %>
<%# Reçoit : token (jeton reçu par e-mail), error[]. %>
<%# En-tête commun. %>
<%- include("partials/header") %>
<%# Page de choix du nouveau mot de passe. %>
<main class="auth-page">
  <div class="auth-container">
    <h1>Nouveau mot de passe</h1>
    <p>Choisissez un nouveau mot de passe sécurisé.</p>
    <%# Message d'erreur éventuel (mot de passe trop court, confirmation différente...). %>
    <% if (error && error.length) { %>
      <div class="alert alert-error"><%= error[0] %></div>
    <% } %>
    <%# Formulaire : envoie le nouveau mot de passe avec le jeton présent dans l'URL. %>
    <form action="/reset-password/<%= token %>" method="POST" >
      <label for="password">Nouveau mot de passe</label>
      <%# Nouveau mot de passe, 8 caractères minimum. %>
      <input type="password" id="password" name="password" minlength="8" autocomplete="new-password" required >
      <label for="confirmPassword">Confirmer le mot de passe</label>
      <%# Confirmation : doit être identique (vérifié aussi côté serveur). %>
      <input type="password" id="confirmPassword" name="confirmPassword" minlength="8" autocomplete="new-password" required >
      <button type="submit"> Modifier mon mot de passe </button>
    </form>
  </div>
</main>
<%# Pied de page commun. %>
<%- include("partials/footer") %>
